{
  "name": "@jinn-network/canonical-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Public site rendering Jinn's canonical docs (SPEC, THESIS, BRAND, GROWTH, GLOSSARY)",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "yarn sync && astro dev",
    "build": "yarn sync && astro build",
    "preview": "astro preview",
    "start": "serve dist -l tcp://0.0.0.0:${PORT:-4321} --no-clipboard",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.1.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "serve": "^14.2.4",
    "typescript": "^5.7.3"
  }
}
