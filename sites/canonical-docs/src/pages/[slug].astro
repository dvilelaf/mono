---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('canonical');
  return docs.map((doc) => ({
    params: { slug: doc.data.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const toc = headings.filter((h) => h.depth === 2);
const hasToc = toc.length > 1;
---

<BaseLayout
  title={doc.data.title}
  description={doc.data.summary}
  currentSlug={doc.data.slug}
>
  <article class="doc">
    <header class="doc__header">
      <p class="label doc__eyebrow">
        <a href="/">Canon</a>
        <span class="doc__sep">/</span>
        {doc.data.sourceFile}
      </p>
      <h1 class="doc__title">{doc.data.title}</h1>
      <p class="doc__summary">{doc.data.summary}</p>
    </header>

    <div class:list={['doc__layout', hasToc && 'doc__layout--has-toc']}>
      {
        hasToc && (
          <>
            {/* Inline collapsible TOC on mobile */}
            <details class="doc__toc-mobile">
              <summary>
                <span class="label">Sections</span>
                <span class="doc__toc-mobile-count">
                  {String(toc.length).padStart(2, '0')}
                </span>
              </summary>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>

            {/* Sticky side rail on desktop only */}
            <aside class="doc__toc" aria-label="Sections">
              <p class="label doc__toc-label">Sections</p>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </aside>
          </>
        )
      }

      <div class="prose doc__body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .doc__header {
    max-width: 72ch;
    margin: 0 auto var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: var(--border-hair);
  }

  .doc__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--fg-dim);
  }
  .doc__eyebrow a {
    color: var(--fg-muted);
    text-decoration: none;
  }
  .doc__eyebrow a:hover {
    color: var(--accent);
  }
  .doc__sep {
    margin: 0 var(--space-2);
    color: var(--fg-dim);
  }

  /* Fluid display size — never overflows narrow viewports. */
  .doc__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 9vw, 64px);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    margin: 0 0 var(--space-3);
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .doc__summary {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: var(--lh-base);
    color: var(--fg-muted);
    margin: 0;
    max-width: 60ch;
  }

  .doc__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  /* Mobile-first: inline collapsible TOC, body below. */
  .doc__toc { display: none; }

  .doc__toc-mobile {
    max-width: 72ch;
    margin: 0 auto var(--space-5);
    border: var(--border-hair);
    border-radius: var(--radius-3);
    background: var(--bg-elevated);
    overflow: hidden;
  }
  .doc__toc-mobile summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    user-select: none;
  }
  .doc__toc-mobile summary::-webkit-details-marker { display: none; }
  .doc__toc-mobile summary::after {
    content: '+';
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--fg-dim);
    line-height: 1;
    transition: transform var(--dur-base) var(--ease-linear);
  }
  .doc__toc-mobile[open] summary::after { content: '−'; }
  .doc__toc-mobile-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }
  .doc__toc-mobile ol {
    list-style: none;
    counter-reset: toc;
    margin: 0;
    padding: 0 var(--space-4) var(--space-4);
    border-top: var(--border-hair);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .doc__toc-mobile li {
    counter-increment: toc;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--lh-base);
    padding-top: var(--space-2);
  }
  .doc__toc-mobile li:first-child { padding-top: var(--space-3); }
  .doc__toc-mobile li::before {
    content: counter(toc, decimal-leading-zero) '.';
    color: var(--fg-dim);
    margin-right: var(--space-2);
    font-variant-numeric: tabular-nums;
  }
  .doc__toc-mobile a {
    color: var(--fg-muted);
    text-decoration: none;
  }
  .doc__toc-mobile a:hover,
  .doc__toc-mobile a:focus-visible {
    color: var(--accent);
  }

  @media (min-width: 960px) {
    .doc__toc-mobile { display: none; }
    .doc__layout--has-toc {
      grid-template-columns: 220px 1fr;
      gap: var(--space-7);
      align-items: start;
    }
    .doc__layout--has-toc .doc__body { margin: 0; }

    .doc__toc {
      display: block;
      position: sticky;
      top: calc(var(--space-7) + 56px);
      align-self: start;
      padding: var(--space-4);
      border: var(--border-hair);
      border-radius: var(--radius-3);
      background: var(--bg-elevated);
      max-height: calc(100vh - 120px);
      overflow-y: auto;
    }
    .doc__toc-label {
      margin: 0 0 var(--space-3);
      color: var(--fg-dim);
    }
    .doc__toc ol {
      list-style: none;
      counter-reset: toc;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .doc__toc li {
      counter-increment: toc;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: var(--lh-base);
    }
    .doc__toc li::before {
      content: counter(toc, decimal-leading-zero) '.';
      color: var(--fg-dim);
      margin-right: var(--space-2);
      font-variant-numeric: tabular-nums;
    }
    .doc__toc a {
      color: var(--fg-muted);
      text-decoration: none;
    }
    .doc__toc a:hover,
    .doc__toc a:focus-visible {
      color: var(--accent);
    }
  }
</style>
