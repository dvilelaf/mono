---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Sigil from '../components/Sigil.astro';

const docs = (await getCollection('canonical')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Canon" description="Canonical docs for the Jinn protocol — stable sources of truth.">
  <header class="hero">
    <div class="hero__mark">
      <Sigil size={64} />
    </div>
    <p class="label">canonical docs</p>
    <h1 class="hero__title">Canon.</h1>
    <p class="hero__lead">
      Stable sources of truth for the Jinn protocol. Read these before
      reasoning about the loop, the brand, distribution, or any
      Jinn-specific term. They change only via approved PRs.
    </p>
  </header>

  <section class="docs">
    {
      docs.map((doc) => (
        <a class="doc-card" href={`/${doc.data.slug}`}>
          <p class="label doc-card__eyebrow">{doc.data.sourceFile}</p>
          <h2 class="doc-card__title">{doc.data.title}</h2>
          <p class="doc-card__summary">{doc.data.summary}</p>
          <span class="doc-card__cta">Read →</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 72ch;
    margin: 0 auto var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: var(--border-hair);
  }
  .hero__mark {
    color: var(--gold);
    margin-bottom: var(--space-4);
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-6xl);
    line-height: var(--lh-tight);
    margin: var(--space-2) 0 var(--space-4);
    color: var(--fg);
  }
  .hero__lead {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: var(--lh-loose);
    color: var(--fg-muted);
    margin: 0;
    max-width: 60ch;
  }

  .docs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .doc-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--bg-elevated);
    border: var(--border-hair);
    border-radius: var(--radius-3);
    color: var(--fg);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-linear),
      transform var(--dur-base) var(--ease-linear);
  }
  .doc-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .doc-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .doc-card__eyebrow {
    margin: 0;
    color: var(--fg-dim);
  }

  .doc-card__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-2xl);
    line-height: var(--lh-snug);
    margin: 0;
    color: var(--fg);
  }

  .doc-card__summary {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--lh-base);
    color: var(--fg-muted);
    margin: 0;
    flex: 1;
  }

  .doc-card__cta {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .doc-card:hover .doc-card__cta {
    color: var(--accent-hover);
  }
</style>
