---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Sigil from '../components/Sigil.astro';

const docs = (await getCollection('canonical')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Featured = the upstream doc (PRINCIPLES); the rest stack below.
const [featured, ...rest] = docs;
---

<BaseLayout title="Canon" description="Canonical docs for the Jinn protocol — stable sources of truth.">
  <header class="hero">
    <div class="hero__mark">
      <Sigil size={56} />
    </div>
    <p class="label">canonical docs</p>
    <h1 class="hero__title">Canon.</h1>
    <p class="hero__lead">
      Stable sources of truth for the Jinn protocol. Read these before
      reasoning about the loop, the brand, distribution, or any
      Jinn-specific term. They change only via approved PRs.
    </p>
  </header>

  {featured && (
    <a class="doc-card doc-card--featured" href={`/${featured.data.slug}`}>
      <div class="doc-card--featured__inner">
        <div class="doc-card--featured__lhs">
          <p class="label doc-card__eyebrow">{featured.data.sourceFile}</p>
          <h2 class="doc-card--featured__title">{featured.data.title}</h2>
        </div>
        <div class="doc-card--featured__rhs">
          <p class="doc-card--featured__summary">{featured.data.summary}</p>
          <span class="doc-card__cta">Read →</span>
        </div>
      </div>
    </a>
  )}

  <section class="docs" aria-label="Other canonical docs">
    {
      rest.map((doc) => (
        <a class="doc-card" href={`/${doc.data.slug}`}>
          <p class="label doc-card__eyebrow">{doc.data.sourceFile}</p>
          <h2 class="doc-card__title">{doc.data.title}</h2>
          <p class="doc-card__summary">{doc.data.summary}</p>
          <span class="doc-card__cta">Read →</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 72ch;
    margin: 0 auto var(--space-7);
    padding-bottom: var(--space-6);
    border-bottom: var(--border-hair);
  }
  .hero__mark {
    color: var(--gold);
    margin-bottom: var(--space-4);
    line-height: 0;
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(56px, 14vw, 88px);
    line-height: var(--lh-tight);
    margin: var(--space-2) 0 var(--space-4);
    color: var(--fg);
  }
  .hero__lead {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: var(--lh-loose);
    color: var(--fg-muted);
    margin: 0;
    max-width: 60ch;
  }

  /* Featured doc: upstream-of-everything-else card.
     Full width, two-column inside on wide; stacked on mobile. */
  .doc-card--featured {
    display: block;
    text-decoration: none;
    color: var(--fg);
    padding: var(--space-5);
    margin-bottom: var(--space-4);
    background: var(--bg-elevated);
    border: var(--border-hair);
    border-radius: var(--radius-3);
    transition: border-color var(--dur-base) var(--ease-linear);
  }
  .doc-card--featured:hover,
  .doc-card--featured:focus-visible {
    border-color: var(--border-strong);
  }
  .doc-card--featured__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 720px) {
    .doc-card--featured { padding: var(--space-6) var(--space-7); }
    .doc-card--featured__inner {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-7);
      align-items: end;
    }
  }
  .doc-card--featured__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 8vw, 64px);
    line-height: var(--lh-tight);
    margin: var(--space-2) 0 0;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .doc-card--featured__rhs {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .doc-card--featured__summary {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: var(--lh-loose);
    color: var(--fg-muted);
    margin: 0;
  }

  .docs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .doc-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--bg-elevated);
    border: var(--border-hair);
    border-radius: var(--radius-3);
    color: var(--fg);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-linear);
  }
  .doc-card:hover,
  .doc-card:focus-visible {
    border-color: var(--border-strong);
  }

  .doc-card__eyebrow {
    margin: 0;
    color: var(--fg-dim);
  }

  .doc-card__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-2xl);
    line-height: var(--lh-snug);
    margin: 0;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .doc-card__summary {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--lh-base);
    color: var(--fg-muted);
    margin: 0;
    flex: 1;
  }

  .doc-card__cta {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .doc-card:hover .doc-card__cta,
  .doc-card--featured:hover .doc-card__cta {
    color: var(--accent-hover);
  }
</style>
