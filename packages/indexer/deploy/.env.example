# Environment variables for @jinn-network/indexer VPS deployment.
# Copy to .env and fill in real values before running.
#
# NEVER commit a filled .env file to version control.

# ── RPC endpoints ─────────────────────────────────────────────────────────────

# Base Sepolia (testnet). Required for testnet indexing.
PONDER_RPC_URL_84532=https://sepolia.base.org

# Base mainnet. Required for mainnet indexing.
# For production, use a HyperSync-backed RPC URL from Envio for higher
# throughput: https://envio.dev
PONDER_RPC_URL_8453=https://mainnet.base.org

# ── Database ──────────────────────────────────────────────────────────────────

# Postgres connection string. Required for production (yarn start / yarn serve).
# Omit entirely for local dev with PGlite (yarn dev).
DATABASE_URL=postgresql://user:password@localhost:5432/jinn_indexer

# Optional: schema isolation for zero-downtime deployments.
# When set, Ponder uses this schema name in Postgres instead of 'public'.
# Useful when running two indexer instances against the same database during
# a rolling update.
# DATABASE_SCHEMA=jinn_indexer_v1

# ── Ponder runtime settings ───────────────────────────────────────────────────

# Port the Ponder HTTP server listens on. Defaults to 42069.
# PORT=42069

# Log level. One of: silent, error, warn, info, debug, trace.
# PONDER_LOG_LEVEL=info

# ── Snapshot sync (optional) ──────────────────────────────────────────────────

# When syncing from a snapshot rather than genesis, set this to the snapshot
# block height. Snapshot CIDs are published in daemon release notes.
# PONDER_START_BLOCK=<snapshot-height>
